<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Default document setup -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- PHP and static file handler -->
    <handlers accessPolicy="Read, Execute, Script">
      <clear />
      <add name="PHP via FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="File" />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>

    <!-- URL Rewrite Rules -->
    <rewrite>
      <rules>

        <!-- 1. Redirect all HTTP to HTTPS -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Redirect www to non-www -->
        <rule name="Redirect WWW to non-WWW" enabled="true" stopProcessing="true">
          <match url="(.*)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3. Redirect .php URLs to clean URLs -->
        <rule name="Redirect .php to clean URL" stopProcessing="true">
          <match url="(.*)\.php$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- SEO slug redirects and rewrites (Alle Kids All Website Slug) -->
        <!-- 301: old root slugs -> new nested slugs -->
        <rule name="Old school-calendar redirect" stopProcessing="true">
          <match url="^school-calendar/?$" ignoreCase="true" />
          <action type="Redirect" url="/parent-resources/school-calendar" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old daily-routine redirect" stopProcessing="true">
          <match url="^daily-routine/?$" ignoreCase="true" />
          <action type="Redirect" url="/parent-resources/daily-routine" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old tips-for-parent redirect" stopProcessing="true">
          <match url="^tips-for-parent/?$" ignoreCase="true" />
          <action type="Redirect" url="/parent-resources/tips-for-parents" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old health-safety-policies redirect" stopProcessing="true">
          <match url="^health-safety-policies/?$" ignoreCase="true" />
          <action type="Redirect" url="/parent-resources/health-safety-policies" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old testimonial redirect" stopProcessing="true">
          <match url="^testimonial/?$" ignoreCase="true" />
          <action type="Redirect" url="/parent-resources/testimonials" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old photos redirect" stopProcessing="true">
          <match url="^photos/?$" ignoreCase="true" />
          <action type="Redirect" url="/gallery/photos" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old videos redirect" stopProcessing="true">
          <match url="^videos/?$" ignoreCase="true" />
          <action type="Redirect" url="/gallery/videos" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old student-work-sample redirect" stopProcessing="true">
          <match url="^student-work-sample/?$" ignoreCase="true" />
          <action type="Redirect" url="/gallery/student-work-samples" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Old virtual-tour redirect" stopProcessing="true">
          <match url="^virtual-tour/?$" ignoreCase="true" />
          <action type="Redirect" url="/gallery/virtual-tour" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Rewrite new nested slugs to existing page content -->
        <rule name="Rewrite parent-resources school-calendar" stopProcessing="true">
          <match url="^parent-resources/school-calendar/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=school-calendar" appendQueryString="true" />
        </rule>
        <rule name="Rewrite parent-resources daily-routine" stopProcessing="true">
          <match url="^parent-resources/daily-routine/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=daily-routine" appendQueryString="true" />
        </rule>
        <rule name="Rewrite parent-resources tips-for-parents" stopProcessing="true">
          <match url="^parent-resources/tips-for-parents/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=tips-for-parent" appendQueryString="true" />
        </rule>
        <rule name="Rewrite parent-resources health-safety-policies" stopProcessing="true">
          <match url="^parent-resources/health-safety-policies/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=health-safety-policies" appendQueryString="true" />
        </rule>
        <rule name="Rewrite parent-resources testimonials" stopProcessing="true">
          <match url="^parent-resources/testimonials/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=testimonial" appendQueryString="true" />
        </rule>
        <rule name="Rewrite gallery photos" stopProcessing="true">
          <match url="^gallery/photos/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=photos" appendQueryString="true" />
        </rule>
        <rule name="Rewrite gallery videos" stopProcessing="true">
          <match url="^gallery/videos/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=videos" appendQueryString="true" />
        </rule>
        <rule name="Rewrite gallery student-work-samples" stopProcessing="true">
          <match url="^gallery/student-work-samples/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=student-work-sample" appendQueryString="true" />
        </rule>
        <rule name="Rewrite gallery virtual-tour" stopProcessing="true">
          <match url="^gallery/virtual-tour/?$" ignoreCase="true" />
          <action type="Rewrite" url="page-template.php?page=virtual-tour" appendQueryString="true" />
        </rule>

        <!-- Program page rewrites (PDF program page slugs) -->
        <rule name="Program playgroup-1" stopProcessing="true">
          <match url="^programs/playgroup-1/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=top-playgroup-school-in-bareilly-allen-kids" appendQueryString="true" />
        </rule>
        <rule name="Program playgroup-2" stopProcessing="true">
          <match url="^programs/playgroup-2/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=enroll-at-top-preschool-playgroup-near-bareilly-allen-kids" appendQueryString="true" />
        </rule>
        <rule name="Program nursery" stopProcessing="true">
          <match url="^programs/nursery/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=best-nursery-school-near-bareilly-allen-kids-preschool" appendQueryString="true" />
        </rule>
        <rule name="Program preparatory" stopProcessing="true">
          <match url="^programs/preparatory/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=preparatory-program-for-kids-in-bareilly-allen-kids" appendQueryString="true" />
        </rule>
        <rule name="Program class-1" stopProcessing="true">
          <match url="^programs/class-1/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=best-school-in-bareilly-for-class-1-allen-kids" appendQueryString="true" />
        </rule>
        <rule name="Program class-2" stopProcessing="true">
          <match url="^programs/class-2/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=best-school-for-class-2-in-bareilly-allen-kids" appendQueryString="true" />
        </rule>
        <rule name="Program class-3" stopProcessing="true">
          <match url="^programs/class-3/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=best-primary-school-for-class-3-in-bareilly-allen-kids" appendQueryString="true" />
        </rule>
        <rule name="Program day-care" stopProcessing="true">
          <match url="^programs/day-care/?$" ignoreCase="true" />
          <action type="Rewrite" url="program-single.php?slug=best-daycare-school-in-bareilly-allen-kids" appendQueryString="true" />
        </rule>

        <!-- 4. Add trailing slash for directories -->
        <rule name="Add trailing slash for directories" stopProcessing="true">
          <match url="(.*[^/])$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\{R:1}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}/" redirectType="Permanent" />
        </rule>

        <!-- 5. Directory index support -->
        <rule name="Directory index support" stopProcessing="true">
          <match url="^(.*?)/?$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\{R:1}\index.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.php" />
        </rule>

        <!-- 6. Rewrite clean URLs to .php (exclude static files) -->
        <rule name="Rewrite clean URL to .php" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}\{R:1}.php" matchType="IsFile" />
            <!-- Exclude static assets and files like .apk -->
            <add input="{R:1}" pattern="^.*\.(jpg|jpeg|png|gif|css|js|pdf|svg|ico|webp|apk|zip|rar|txt|xml|json|mp4|webm|ogg)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" />
        </rule>

        <!-- 7. Home page route -->
        <rule name="Home page route" stopProcessing="true">
          <match url="^home$" />
          <action type="Rewrite" url="index.php" />
        </rule>

        <!-- 8. Blog, Event, Gallery, Newsletter routes -->
        <rule name="Events list" stopProcessing="true">
          <match url="^events/?$" ignoreCase="true" />
          <action type="Rewrite" url="events.php" appendQueryString="true" />
        </rule>

        <rule name="Event detail" stopProcessing="true">
          <match url="^event/([0-9]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="event-detail.php?id={R:1}" appendQueryString="true" />
        </rule>

        <rule name="Blog clean route" stopProcessing="true">
          <match url="^blog/([A-Za-z0-9-]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="blog-detail.php?slug={R:1}" appendQueryString="true" />
        </rule>

        <rule name="Legacy blog detail redirect" stopProcessing="true">
          <match url="^blog-detail/([A-Za-z0-9-]+)/?$" ignoreCase="true" />
          <action type="Redirect" url="/blog/{R:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <rule name="Gallery list" stopProcessing="true">
          <match url="^gallery/?$" ignoreCase="true" />
          <action type="Rewrite" url="gallery-list.php" appendQueryString="true" />
        </rule>

        <rule name="Gallery detail" stopProcessing="true">
          <match url="^gallery/([0-9]+)/?$" ignoreCase="true" />
          <action type="Rewrite" url="gallery-detail.php?id={R:1}" appendQueryString="true" />
        </rule>

        <rule name="Newsletter list" stopProcessing="true">
          <match url="^newsletter/?$" ignoreCase="true" />
          <action type="Rewrite" url="newsletters.php" appendQueryString="true" />
        </rule>

        <rule name="Serve static files from root" stopProcessing="true">
            <match url="^(css|js|images|assets|fonts)/(.+)$" />
            <action type="Rewrite" url="{R:1}/{R:2}" />
        </rule>

        <!-- 9. View route -->
        <rule name="View route" stopProcessing="true">
          <match url="^view/([A-Za-z0-9-]+)$" />
          <action type="Rewrite" url="detail-view.php?slug={R:1}" />
        </rule>

        <!-- 10. Page route (exclude static files) -->
        <rule name="Page route" stopProcessing="true">
          <match url="^([^/]+)/?$" />
          <conditions>
            <add input="{R:1}" pattern="^.*\.(jpg|jpeg|png|gif|css|js|pdf|svg|ico|webp|apk|zip|rar|txt|xml|json|mp4|webm|ogg)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="page-template.php?page={R:1}" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
